<UserControl x:Class="VWP.CityPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,24,30,24">
  <TextBlock Text="Эксклюзивы" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Обои, в которые можно войти." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,22"/>
  <Border Background="#080E1C" CornerRadius="22" ClipToBounds="True"><Grid Height="290"><Image x:Name="Cover" Stretch="UniformToFill"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#ED07121E"/><GradientStop Offset=".6" Color="#4007121E"/><GradientStop Offset="1" Color="#1007121E"/></LinearGradientBrush></Border.Background></Border><StackPanel VerticalAlignment="Center" Margin="30"><TextBlock Text="VWP ORIGINAL · INFINITE WORLD" Foreground="#8DDAF2" FontSize="9"/><TextBlock Text="Afterlight" FontSize="42" Foreground="White" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="У этого города нет последней улицы." Foreground="#C5D8E7" FontSize="13"/><TextBlock Text="Дождь. Неон. Ночной экспресс. Твой маршрут." Foreground="#9BB3C8" Margin="0,7,0,20"/><StackPanel Orientation="Horizontal"><Button x:Name="PreviewButton" Content="Исследовать превью ↗" Background="#E6F2FF" Foreground="#0A192C" Padding="17,12"/><TextBlock x:Name="AccessLabel" Text="★ Открывается за звезду" Foreground="#AFC5E0" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel></StackPanel></Grid></Border>
  <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Бесконечные кварталы" FontWeight="SemiBold"/><TextBlock Text="Город создаётся по ходу движения." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Прогулка и полёт" FontWeight="SemiBold"/><TextBlock Text="WASD, мышь, F и Shift. E — взаимодействие." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Три настроения" FontWeight="SemiBold"/><TextBlock Text="Neon Ward · Sakura · Glacier. R — дождь." FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
  <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,22,0,0"><StackPanel><TextBlock Text="Открой город за звезду" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Поставь звезду domovoyproj/VWP. Подключи свой аккаунт ключом GitHub с правом Starring: Read-only. Ключ защищён Windows и остаётся на этом ПК." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,12"/><WrapPanel><Button x:Name="RepositoryButton" Content="Репозиторий ↗"/><Button x:Name="TokenHelpButton" Content="Создать ключ ↗" Margin="8,0"/><Button x:Name="DisconnectButton" Content="Отключить аккаунт" Background="Transparent"/></WrapPanel><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="Token" Padding="12,9" ToolTip="Fine-grained personal access token: Account permissions → Starring → Read-only. Public repositories."/><Button x:Name="CheckButton" Grid.Column="1" Content="Проверить звезду" Margin="10,0,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="White"/></Grid><TextBlock x:Name="Status" Text="Подключи GitHub, чтобы применить город к рабочему столу." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,11,0,0"/></StackPanel></Border>
  <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,16,0,0"><WrapPanel VerticalAlignment="Center"><ComboBox x:Name="Palette" Width="170" SelectedIndex="0"><ComboBoxItem Content="Neon Ward"/><ComboBoxItem Content="Sakura Quarter"/><ComboBoxItem Content="Glacier District"/></ComboBox><ComboBox x:Name="Quality" Width="145" SelectedIndex="2" Margin="10,0"><ComboBoxItem Content="Экономия"/><ComboBoxItem Content="Баланс"/><ComboBoxItem Content="Качество"/></ComboBox><Button x:Name="ApplyButton" Content="Применить город ↗" Background="{DynamicResource PrimaryBrush}" Foreground="White" IsEnabled="False"/><Button x:Name="ExploreButton" Content="Войти в свои обои" Margin="10,0,0,0" Background="Transparent"/></WrapPanel></Border>
  <TextBlock x:Name="ControlsHint" Text="Ctrl + Alt + N — войти в город. Esc освобождает курсор; красный круг возвращает к рабочему столу." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,16,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
