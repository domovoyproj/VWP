<Window x:Class="VWP.MiniPlayer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="320" Height="340" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
 <Border Background="{DynamicResource CardBrush}" CornerRadius="20" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="18"><StackPanel>
  <DockPanel><Button x:Name="OpenButton" Content="Открыть VWP ↗" Background="Transparent" FontSize="11" Padding="0,4" DockPanel.Dock="Left"/><Button x:Name="CloseButton" Content="×" Padding="8,4" Background="Transparent" HorizontalAlignment="Right"/></DockPanel>
  <ComboBox x:Name="Display" Margin="0,10,0,10"/>
  <Border CornerRadius="12" Height="110" ClipToBounds="True" Background="#191A29"><Image x:Name="Cover" Stretch="UniformToFill"/></Border>
  <TextBlock x:Name="TitleLabel" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,8" TextTrimming="CharacterEllipsis"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="Previous" Content="←" Padding="15,8"/><Button x:Name="Pause" Content="Ⅱ Пауза" Padding="15,8" Margin="7,0"/><Button x:Name="Next" Content="→" Padding="15,8"/></StackPanel>
  <Slider x:Name="Sound" Minimum="0" Maximum="100" Margin="0,8,0,0"/>
 </StackPanel></Border>
</Window>
