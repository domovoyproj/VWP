<Window x:Class="VWP.StudioEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration" Title="VWP · Scene Studio" Width="1380" Height="860" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#0C1018" Foreground="#EBEFF7" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" PreviewKeyDown="EditorKeyDown">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A5B2C8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5B2C8"/><Setter Property="Margin" Value="0,15,0,7"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="#1B2332"/><Setter Property="Foreground" Value="#F0F3FA"/></Style>
  <Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TabPanel IsItemsHost="True"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,14,0,0"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#92A7C7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" CornerRadius="7" Padding="14,10" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#263A56"/><Setter Property="Foreground" Value="#ECF3FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
  <Border BorderBrush="#222D3E" BorderThickness="0,0,0,1" Padding="24,14">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Закрыть" Click="CancelClick" Background="#202A3A" Margin="0,0,10,0" Padding="16,10"/><Button x:Name="SaveButton" Content="Сохранить и применить" Click="SaveClick" Background="#A5C6FF" Foreground="#101A2D" Padding="20,10"/></StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#A5C6FF" CornerRadius="8" Padding="10,8"><TextBlock Text="S" Foreground="#0C1629" FontSize="21" FontWeight="Bold"/></Border><StackPanel Margin="14,0,24,0"><TextBlock Text="SCENE STUDIO" FontSize="10" Foreground="#8DA8D0"/><TextBlock Text="Редактор живых сцен" Foreground="#F0F3FA" FontSize="17" Margin="0,4,0,0"/></StackPanel></StackPanel>
   </DockPanel>
  </Border>
  <Grid x:Name="Workspace" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition/><ColumnDefinition Width="278"/></Grid.ColumnDefinitions>
   <Border Background="#111722" BorderBrush="#222D3E" BorderThickness="0,0,1,0" Padding="16,20">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="КОМПОЗИЦИЯ" FontSize="10" Foreground="#7F96B9"/><TextBox x:Name="SceneName" Margin="0,12,0,18" TextChanged="NameChanged" ToolTip="Название сцены"/><TextBlock Text="Слои · снизу вверх" FontSize="11" Margin="0,0,0,10"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom"><WrapPanel Margin="0,10,0,10"><Button Content="↓" Click="DownClick" ToolTip="Ниже" Margin="0,0,6,0"/><Button Content="↑" Click="UpClick" ToolTip="Выше" Margin="0,0,6,0"/><Button Content="Удалить" Click="RemoveClick"/></WrapPanel><Button Content="＋ Добавить изображение" Click="AddClick" Padding="9,10"/><TextBlock Text="PNG с прозрачностью — для отдельных ветвей, персонажей и деталей переднего плана." FontSize="10" Margin="0,14,0,0" LineHeight="16"/></StackPanel>
     <ListBox x:Name="LayerList" SelectionChanged="LayerSelected" Background="Transparent" BorderThickness="0" Foreground="#F0F3FA" DisplayMemberPath="Name">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Foreground" Value="#D8E5F8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LayerCard" Padding="{TemplateBinding Padding}" Background="#161F2E" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LayerCard" Property="Background" Value="#263A56"/><Setter TargetName="LayerCard" Property="BorderBrush" Value="#658CBF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LayerCard" Property="BorderBrush" Value="#658CBF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" Margin="18,20,18,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="78"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14"><TextBlock x:Name="ViewLabel" Text="Живой просмотр" Foreground="#E5EDF9" FontSize="13"/><TextBlock Text="16:9 · GPU" HorizontalAlignment="Right" Foreground="#7F96B9"/></DockPanel>
    <Border Grid.Row="1" Background="#070A10" BorderBrush="#26354A" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
     <Grid x:Name="Stage" SizeChanged="StageSized"><wfi:WindowsFormsHost x:Name="Viewport" Focusable="True" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition/></Grid.RowDefinitions><DockPanel><Button x:Name="PauseButton" Content="Ⅱ Пауза" Click="PauseClick" DockPanel.Dock="Left" Padding="10,6"/><TextBlock x:Name="TimeLabel" Text="00:00" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="Timeline" Minimum="0" Maximum="24" Margin="16,0" PreviewMouseDown="TimelineDown" PreviewMouseUp="TimelineUp" ValueChanged="TimelineChanged" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Text="Пробел — пауза     Ctrl+Z — отменить мазок     Esc — закончить маску" Foreground="#7286A4" FontSize="10" VerticalAlignment="Bottom"/></Grid>
   </Grid>
   <Border Grid.Column="2" Background="#111722" BorderBrush="#222D3E" BorderThickness="1,0,0,0">
    <TabControl Margin="14,14,14,0">
     <TabItem Header="Слой"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,4,4,20">
     <TextBlock Text="СВОЙСТВА СЛОЯ" Foreground="#7F96B9" FontSize="10"/>
     <TextBox x:Name="LayerName" Margin="0,12,0,12" TextChanged="LayerNameChanged"/>
     <CheckBox x:Name="LayerVisible" Content="Показывать слой" Click="PropertiesChanged" Foreground="#EBEFF7"/>
     <TextBlock Text="Анимация" Style="{StaticResource Label}"/><ComboBox x:Name="Motion" SelectionChanged="PropertiesChanged"><ComboBoxItem Content="Без деформации"/><ComboBoxItem Content="Поток · вода и облака"/><ComboBoxItem Content="Ветви и листва"/><ComboBoxItem Content="Ткань"/><ComboBoxItem Content="Персонаж · волосы и дыхание"/><ComboBoxItem Content="Капли на стекле"/></ComboBox>
     <TextBlock Text="Точка закрепления" Style="{StaticResource Label}"/><ComboBox x:Name="Anchor" SelectionChanged="PropertiesChanged"><ComboBoxItem Content="Сверху"/><ComboBoxItem Content="Снизу"/><ComboBoxItem Content="По центру"/></ComboBox>
     <TextBlock Text="Сила движения" Style="{StaticResource Label}"/><Slider x:Name="Strength" Minimum="0" Maximum="3" ValueChanged="PropertiesChanged"/>
     <TextBlock Text="Глубина параллакса" Style="{StaticResource Label}"/><Slider x:Name="Depth" Minimum="0" Maximum="2" ValueChanged="PropertiesChanged"/>
     <TextBlock Text="Непрозрачность" Style="{StaticResource Label}"/><Slider x:Name="LayerOpacity" Minimum="0" Maximum="1" ValueChanged="PropertiesChanged"/>
     <TextBlock Text="Положение X / Y" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Slider x:Name="LayerX" Minimum="-2" Maximum="2" ValueChanged="PropertiesChanged" Margin="0,0,8,0"/><Slider x:Name="LayerY" Grid.Column="1" Minimum="-2" Maximum="2" ValueChanged="PropertiesChanged"/></Grid>
     <TextBlock Text="Размер слоя" Style="{StaticResource Label}"/><Slider x:Name="LayerScale" Minimum="0.1" Maximum="3" ValueChanged="ScaleChanged"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Маски"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,4,4,20">
     <TextBlock Text="МАСКИ ДВИЖЕНИЯ" Foreground="#7F96B9" FontSize="10"/><TextBlock Text="Закрась область эффекта прямо на изображении. Голубой цвет показывает маску." FontSize="10" LineHeight="16" Margin="0,9,0,10"/>
     <ComboBox x:Name="MaskChannel" SelectionChanged="BrushChanged"><ComboBoxItem Content="Вода · преломление"/><ComboBoxItem Content="Облака · течение"/><ComboBoxItem Content="Ветер · волосы, ткань, ветви"/><ComboBoxItem Content="Свет / дыхание персонажа"/></ComboBox>
     <CheckBox x:Name="Painting" Content="Рисовать маску" Click="BrushChanged" Margin="0,12,0,8" Foreground="#EBEFF7"/><CheckBox x:Name="Erase" Content="Стирать" Click="BrushChanged" Foreground="#EBEFF7"/>
     <TextBlock Text="Размер мягкой кисти" Style="{StaticResource Label}"/><Slider x:Name="BrushRadius" Minimum="0.008" Maximum="0.15" Value="0.045" ValueChanged="BrushChanged"/>
     <WrapPanel Margin="0,12,0,0"><Button Content="Отменить" Click="UndoClick" Margin="0,0,8,0"/><Button Content="Повторить" Click="RedoClick"/></WrapPanel>
     <TextBlock Text="Граница воды" Style="{StaticResource Label}"/><Slider x:Name="Waterline" Minimum="0" Maximum="1" ValueChanged="PropertiesChanged"/>
     <TextBlock Text="Блики · положение солнца" Style="{StaticResource Label}"/><Slider x:Name="SunX" Minimum="0" Maximum="1" ValueChanged="PropertiesChanged"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Сцена"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,4,4,20">
     <TextBlock Text="ВСЯ СЦЕНА" Foreground="#7F96B9" FontSize="10"/>
     <TextBlock Text="Общее движение" Style="{StaticResource Label}"/><Slider x:Name="SceneMotion" Minimum="0" Maximum="2" ValueChanged="SettingsChanged"/>
     <TextBlock Text="Ветер" Style="{StaticResource Label}"/><Slider x:Name="Wind" Minimum="0" Maximum="2" ValueChanged="SettingsChanged"/>
     <TextBlock Text="Параллакс курсора" Style="{StaticResource Label}"/><Slider x:Name="Parallax" Minimum="0" Maximum="1" ValueChanged="SettingsChanged"/>
     <TextBlock Text="Экспозиция" Style="{StaticResource Label}"/><Slider x:Name="Exposure" Minimum="-1" Maximum="1" ValueChanged="SettingsChanged"/>
     <TextBlock Text="Свечение ярких участков" Style="{StaticResource Label}"/><Slider x:Name="Bloom" Minimum="0" Maximum="0.4" ValueChanged="SettingsChanged"/>
     <TextBlock Text="Атмосфера" Style="{StaticResource Label}"/><ComboBox x:Name="Weather" SelectionChanged="WeatherChanged"><ComboBoxItem Content="Без частиц"/><ComboBoxItem Content="Снег"/><ComboBoxItem Content="Пылинки"/><ComboBoxItem Content="Светлячки"/></ComboBox>
     <TextBlock Text="Количество частиц" Style="{StaticResource Label}"/><Slider x:Name="ParticleCount" Minimum="0" Maximum="400" ValueChanged="WeatherChanged"/>
     <CheckBox x:Name="Clock" Content="Часы" Click="SettingsChanged" Foreground="#EBEFF7" Margin="0,15,0,8"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#0F1520" BorderBrush="#222D3E" BorderThickness="0,1,0,0" Padding="20,11"><DockPanel><TextBlock x:Name="Statistics" DockPanel.Dock="Right" Foreground="#8095B3" FontSize="10"/><TextBlock x:Name="Status" Text="Подготавливаю графику…" Foreground="#A4B8D4" FontSize="10"/></DockPanel></Border>
 </Grid>
</Window>
