<UserControl x:Class="VWP.VideoEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource CanvasBrush}" CornerRadius="22" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><Button x:Name="CloseButton" Content="×" DockPanel.Dock="Right" Background="Transparent" Padding="10,3"/><StackPanel><TextBlock Text="Твой идеальный цикл" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="SceneName" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <ScrollViewer Grid.Row="1" MaxHeight="390" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
   <Border Background="#171722" CornerRadius="12" Height="170" ClipToBounds="True"><MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" Volume="0" Stretch="Uniform"/></Border>
   <TextBlock Text="Фрагмент и скорость" FontWeight="SemiBold" Margin="0,16,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Начало, сек" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="Start" Text="0" Padding="9"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Конец, сек" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="End" Text="6" Padding="9"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Скорость ×" Foreground="{DynamicResource MutedBrush}"/><TextBox x:Name="Speed" Text="1" Padding="9"/></StackPanel></Grid>
   <TextBlock Text="Цвет" FontWeight="SemiBold" Margin="0,18,0,6"/><TextBlock Text="Яркость" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Brightness" Minimum="-0.5" Maximum="0.5" Value="0"/><TextBlock Text="Контраст" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Contrast" Minimum="0.5" Maximum="2" Value="1"/><TextBlock Text="Насыщенность" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Saturation" Minimum="0" Maximum="2" Value="1"/>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Сглаживание стыка, сек" FontWeight="SemiBold"/><TextBlock Text="0 — обычный цикл. Переход соединяет конец с началом." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,12,0"/></StackPanel><TextBox Grid.Column="1" x:Name="Seam" Text="0.5" Padding="9"/></Grid>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="Status" Text="Исходное видео сохраняется. Результат добавится отдельной сценой." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="Отмена обработки" Visibility="Collapsed" Padding="12,9" Margin="0,0,8,0"/><Button x:Name="PreviewButton" Content="Проверить цикл" Padding="12,9" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Сохранить в библиотеку" Padding="12,9" Background="{DynamicResource PrimaryBrush}" Foreground="White"/></StackPanel></StackPanel>
 </Grid></Border>
</UserControl>
