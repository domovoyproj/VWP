<Window x:Class="VWP.SceneDesigner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="VWP · Редактор живой сцены" Width="1120" Height="740" MinWidth="900" MinHeight="620" WindowStyle="None" WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" PreviewKeyDown="DesignerKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="78" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,20"><Button x:Name="CloseEditor" Content="Закрыть" DockPanel.Dock="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel><TextBlock Text="Редактор живой сцены" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Фото, слои и движение. Результат виден сразу." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
   <Grid Margin="0,0,22,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#080B12" CornerRadius="14" ClipToBounds="True"><Grid x:Name="PreviewSurface" ClipToBounds="True"/></Border>
    <StackPanel Grid.Row="1" Margin="0,15,0,0"><DockPanel><Button x:Name="PausePreview" Content="Ⅱ Пауза" DockPanel.Dock="Right"/><TextBlock Text="ЖИВОЙ ПРЕДПРОСМОТР" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel><TextBlock Text="Двигай мышью, чтобы увидеть глубину. Изменения сохраняются только кнопкой внизу." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
    <TextBlock Text="Название сцены"/><TextBox x:Name="SceneName" Margin="0,6,0,16" Padding="10,8"/>
    <TextBlock Text="Слои" FontSize="16" FontWeight="SemiBold"/><Button x:Name="BackgroundButton" Content="Заменить фон…" Margin="0,10,0,6"/><Button x:Name="ForegroundButton" Content="Добавить передний план PNG…"/><Button x:Name="RemoveForeground" Content="Убрать передний план" Background="Transparent" FontSize="11" Margin="0,4,0,12"/>
    <TextBlock Text="Эффект окружения" FontWeight="SemiBold"/><ComboBox x:Name="EffectPicker" Margin="0,8,0,12" DisplayMemberPath="Value" SelectedValuePath="Key"/>
    <TextBlock Text="Цвет эффекта · #RRGGBB" FontSize="11"/><TextBox x:Name="AccentBox" Margin="0,6,0,10" Padding="10,8"/>
    <TextBlock x:Name="SpeedLabel"/><Slider x:Name="SpeedSlider" Minimum="0.1" Maximum="3" Value="1" Margin="0,6,0,12"/>
    <TextBlock x:Name="DensityLabel"/><Slider x:Name="DensitySlider" Minimum="0" Maximum="2" Value="1" Margin="0,6,0,12"/>
    <TextBlock Text="Размер частиц"/><Slider x:Name="SizeSlider" Minimum="0.25" Maximum="3" Value="1" Margin="0,6,0,12"/>
    <TextBlock Text="Ветер · влево / вправо"/><Slider x:Name="WindSlider" Minimum="-1" Maximum="1" Value="0.15" Margin="0,6,0,12"/>
    <TextBlock Text="Глубина параллакса"/><Slider x:Name="ParallaxSlider" Minimum="0" Maximum="1" Value="0.5" Margin="0,6,0,12"/>
    <TextBlock Text="Область эффекта" FontWeight="SemiBold"/><TextBlock Text="Верхняя граница" FontSize="11" Margin="0,8,0,0"/><Slider x:Name="TopSlider" Minimum="0" Maximum="0.95" Value="0"/><TextBlock Text="Нижняя граница" FontSize="11" Margin="0,8,0,0"/><Slider x:Name="BottomSlider" Minimum="0.05" Maximum="1" Value="1" Margin="0,0,0,12"/>
    <CheckBox x:Name="AudioCheck" Content="Реакция на системный звук" Margin="0,4,0,12"/><CheckBox x:Name="ClockCheck" Content="Часы и дата" Margin="0,0,0,16"/>
    <TextBlock Text="Качество предпросмотра" FontWeight="SemiBold"/><ComboBox x:Name="QualityPicker" SelectedIndex="1" Margin="0,8,0,12"><ComboBoxItem Content="Экономия · 15 FPS"/><ComboBoxItem Content="Баланс · 30 FPS"/><ComboBoxItem Content="Качество · 60 FPS"/></ComboBox>
    <Button x:Name="ResetButton" Content="Сбросить эффекты" Background="Transparent"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,20,0,0"><Button x:Name="SaveScene" Content="Сохранить сцену" DockPanel.Dock="Right" Background="{DynamicResource PrimaryBrush}" Foreground="White" Padding="20,12"/><TextBlock x:Name="EditorStatus" Text="Сцена рассчитывается в реальном времени; видео рендерить не нужно." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/></DockPanel>
 </Grid>
</Window>
