<UserControl x:Class="VWP.PublishPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource CanvasBrush}" CornerRadius="22" Padding="26"><StackPanel>
  <DockPanel><Button x:Name="CloseButton" Content="×" DockPanel.Dock="Right" Background="Transparent" Padding="10,3"/><TextBlock Text="Поделись своим миром" FontSize="23" FontWeight="SemiBold"/></DockPanel>
  <TextBlock Text="Набор появится в публичном репозитории GitHub и каталоге автора." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,18"/>
  <TextBlock Text="Название набора"/><TextBox x:Name="NameField" Text="Моя коллекция" Padding="10" Margin="0,6,0,12"/>
  <TextBlock Text="Репозиторий GitHub: автор/название"/><TextBox x:Name="Repository" Padding="10" Margin="0,6,0,12"/>
  <TextBlock Text="Токен GitHub с доступом Contents: write к этому репозиторию" FontSize="11"/><PasswordBox x:Name="Token" Padding="10" Margin="0,6,0,12"/>
  <TextBlock Text="Токен используется только для этой публикации и не сохраняется. Будут опубликованы сцены плейлиста выбранного дисплея, либо текущая сцена." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <CheckBox x:Name="Rights" Content="У меня есть право публиковать выбранные материалы" Margin="0,0,0,18"/>
  <TextBlock x:Name="Status" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <Button x:Name="PublishButton" Content="Опубликовать набор" Background="{DynamicResource PrimaryBrush}" Foreground="White" HorizontalAlignment="Right"/>
 </StackPanel></Border>
</UserControl>
