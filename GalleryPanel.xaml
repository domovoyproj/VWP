<UserControl x:Class="VWP.GalleryPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource CanvasBrush}" CornerRadius="22" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><Button x:Name="CloseButton" Content="×" Padding="10,4" Background="Transparent" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Новые миры для рабочего стола" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Коллекции авторов · готовые сцены и настройки" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,15"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" Padding="10,8" ToolTip="Поиск по названию и автору" Margin="0,0,10,0"/><ComboBox x:Name="Category" Grid.Column="1" Margin="0,0,10,0"><ComboBoxItem Content="Все категории"/><ComboBoxItem Content="Аниме"/><ComboBoxItem Content="Космос"/><ComboBoxItem Content="Природа"/><ComboBoxItem Content="Город"/></ComboBox><Button x:Name="RefreshButton" Grid.Column="2" Content="Обновить" Padding="12,8"/></Grid>
  <ListBox x:Name="Entries" Grid.Row="2" MaxHeight="280" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,8"><StackPanel><Image Source="{Binding Thumbnail}" Height="100" Stretch="UniformToFill" Margin="0,0,0,12"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkBrush}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Author}" Foreground="{DynamicResource AccentBrush}" Margin="0,5,0,6"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
  <StackPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="Status" Text="Выберите набор. Загрузка проверяется по SHA-256." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/><StackPanel Orientation="Horizontal"><Button x:Name="AuthorButton" Content="Страница автора" Padding="12,8"/><Button x:Name="DownloadButton" Content="Скачать коллекцию" Padding="12,8" Background="{DynamicResource PrimaryBrush}" Foreground="White" Margin="8,0"/><Button x:Name="PublishButton" Content="Опубликовать свой набор" Padding="12,8"/></StackPanel></StackPanel>
 </Grid></Border>
</UserControl>
