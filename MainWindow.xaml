<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:VWP" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="VWP.MainWindow" Title="VWP Studio" Icon="assets/app.ico" Width="1160" Height="760" MinWidth="980" MinHeight="640" WindowStyle="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" WindowStartupLocation="Manual" KeyDown="WindowKeyDown" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="18" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource CanvasBrush}">
  <Grid.RowDefinitions>
   <RowDefinition Height="48" />
   <RowDefinition />
  </Grid.RowDefinitions>
  <Grid Background="{DynamicResource CanvasBrush}">
   <Border Background="{DynamicResource PanelBrush}" Width="188" HorizontalAlignment="Left" />
   <TextBlock Text="VWP  /  STUDIO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="24,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
   <TextBlock x:Name="ModeLabel" Text="VWP Studio" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" />
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="−" ToolTip="Свернуть в трей" Click="TrayClick" Background="Transparent" Padding="13,8" FontSize="15" />
    <Button Content="□" ToolTip="Полноэкранный режим" Click="ModeClick" Background="Transparent" Padding="13,8" FontSize="14" />
    <Button Content="×" ToolTip="Закрыть VWP" Click="QuitClick" Background="Transparent" Padding="13,8" FontSize="17" />
   </StackPanel>
   <Button x:Name="QualityButton" Click="QualityClick" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,162,0" Padding="12,7" ToolTip="Качество и нагрузка на ПК" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <StackPanel Orientation="Horizontal">
     <Path Data="M 1 9 A 8 8 0 0 1 17 9 M 9 9 L 13 4" Width="16" Height="13" Stretch="Uniform" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Margin="0,0,8,0" />
     <TextBlock x:Name="QualityLabel" Text="Режим · Авто" FontSize="11" />
     <TextBlock Text="⌄" Margin="10,-2,0,0" />
    </StackPanel>
   </Button>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="188" />
    <ColumnDefinition Width="*" />
   </Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="16,18,16,18">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="9,0,0,25">
       <Image Source="assets/app.png" Width="34" Height="34" />
       <StackPanel Margin="12,1,0,0">
        <TextBlock Text="VWP" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="DESKTOP STUDIO" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
       </StackPanel>
      </StackPanel>
      <Button x:Name="WallpaperNav" Tag="Wallpaper" Click="AppearanceNavigation" Background="{DynamicResource SelectedBrush}" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="12,11" FontSize="12">
       <StackPanel Orientation="Horizontal">
        <Path Data="M 1 2 L 17 2 L 17 14 L 1 14 Z M 3 11 L 7 7 L 10 10 L 13 5 L 16 11" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" Width="18" Height="16" Stretch="Uniform" Margin="0,0,11,0" />
        <TextBlock Text="Обои" />
       </StackPanel>
      </Button>
      <Button x:Name="ThemesNav" Tag="Themes" Click="AppearanceNavigation" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,5" Padding="12,11" FontSize="12">
       <StackPanel Orientation="Horizontal">
        <Path Data="M 9 1 C 4 1 1 4 1 8 C 1 12 4 15 8 15 C 10 15 9 12 11 12 L 13 12 C 19 12 17 1 9 1 Z M 5 5 L 5 5.2 M 9 4 L 9 4.2 M 13 5 L 13 5.2" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" Width="18" Height="16" Stretch="Uniform" Margin="0,0,11,0" />
        <TextBlock Text="Темы" />
       </StackPanel>
      </Button>
      <Button x:Name="CursorsNav" Tag="Cursors" Click="AppearanceNavigation" Background="Transparent" HorizontalContentAlignment="Left" Margin="0,0,0,16" Padding="12,11" FontSize="12">
       <StackPanel Orientation="Horizontal">
        <Path Data="M 3 1 L 3 15 L 7 11 L 10 17 L 13 15 L 10 9 L 17 9 Z" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.2" Width="18" Height="17" Stretch="Uniform" Margin="0,0,11,0" />
        <TextBlock Text="Курсоры" />
       </StackPanel>
      </Button>
      <Button x:Name="CityNav" Content="✦ Эксклюзивы" Click="CityNavigation" Background="Transparent" HorizontalContentAlignment="Left" Padding="12,11" Margin="0,0,0,8" FontSize="12" />
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <TextBlock x:Name="CollectionHeading" Text="КОЛЛЕКЦИЯ" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="13,4,0,10" />
       <StackPanel x:Name="SidebarCategories">
        <Button Content="Оригиналы VWP" Tag="Оригиналы VWP" Click="CategoryClick" Background="{DynamicResource SelectedBrush}" HorizontalContentAlignment="Left" FontSize="11" Padding="12,9" Margin="0,0,0,8" FontWeight="SemiBold" />
        <Button Content="Все сцены" Tag="Все сцены" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Избранное" Tag="Избранное" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Плейлист" Tag="Плейлист" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Аниме" Tag="Аниме" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Атмосфера" Tag="Атмосфера" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Зимние пейзажи" Tag="Зима" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Деревня · Зима" Tag="Деревня · Зима" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Деревня · Лето" Tag="Деревня · Лето" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Рисованные девушки" Tag="Рисованные девушки" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Город" Tag="Город" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Природа" Tag="Природа" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Космос" Tag="Космос" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Фэнтези" Tag="Фэнтези" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
        <Button Content="Импорт" Tag="Импорт" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="11" Padding="12,7" Margin="0,0,0,2" FontWeight="Normal" />
       </StackPanel>
       <Button x:Name="SidebarImport" Content="＋ Импорт видео" Click="ImportClick" Background="Transparent" FontSize="11" Padding="13,12" HorizontalContentAlignment="Left" Margin="0,10,0,0" />
      </StackPanel>
     </ScrollViewer>
     <Border x:Name="SidebarNote" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Top" Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="15">
      <StackPanel>
       <TextBlock Text="Твой стиль" FontWeight="SemiBold" FontSize="12" />
       <TextBlock Text="Темы, детали и движение. Всё в одном месте." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" LineHeight="17" Margin="0,8,0,0" />
      </StackPanel>
     </Border>
     <StackPanel Grid.Row="2" Margin="8,14,8,0">
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,10" />
      <Button Content="Галерея ↗" Click="GalleryClick" Background="Transparent" HorizontalContentAlignment="Left" Padding="0,6" FontSize="11" />
      <Button Content="Настройки" Click="SettingsClick" Background="Transparent" HorizontalContentAlignment="Left" Padding="0,9" FontSize="11" />
      <CheckBox x:Name="Autostart" Content="Автозапуск" Click="AutostartClick" Margin="0,7,0,0" />
     </StackPanel>
    </Grid>
   </Border>
   <Grid x:Name="WallpaperPage" Grid.Column="1" Margin="24,18,24,18">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
     <RowDefinition Height="68" />
     <RowDefinition Height="*" />
     <RowDefinition Height="0" />
     <RowDefinition Height="92" />
    </Grid.RowDefinitions>
    <Grid Grid.ColumnSpan="2">
     <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
     </Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Библиотека обоев" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Твой рабочий стол. Твои сцены." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,3,0,0" VerticalAlignment="Top">
      <Border Width="150" Background="{DynamicResource ControlBrush}" CornerRadius="12" Padding="11,10" Margin="0,0,8,0">
       <Grid>
        <TextBox x:Name="SearchBox" Padding="0" TextChanged="SearchChanged" Background="Transparent" BorderThickness="0" FontSize="11" VerticalContentAlignment="Center" />
        <TextBlock Text="Поиск сцен" Foreground="{DynamicResource MutedBrush}" FontSize="11" IsHitTestVisible="False">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Setter Property="Visibility" Value="Collapsed" />
           <Style.Triggers>
            <DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value="">
             <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </Grid>
      </Border>
      <Button Content="Создать сцену" Click="CreateSceneClick" Padding="13,10" FontSize="11" Background="{DynamicResource PrimaryBrush}" Foreground="White" Margin="0,0,8,0"/>
      <Button Content="＋ Импорт" Click="ImportClick" Padding="13,10" FontSize="11" Background="{DynamicResource CardBrush}" />
     </StackPanel>
    </Grid>
    <Border x:Name="Hero" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" CornerRadius="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" SizeChanged="RoundHero" Margin="16,0,0,16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="166"/><RowDefinition/></Grid.RowDefinitions>
      <Grid ClipToBounds="True" Background="#0B0E15"><Image x:Name="HeroImage" Stretch="Uniform"/><MediaElement x:Name="HeroVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close" Volume="0" Stretch="UniformToFill"/><Grid x:Name="HeroMotion" Visibility="Collapsed" IsHitTestVisible="False"/>
       <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#B00D1422" CornerRadius="8" Padding="9,5" Margin="14"><TextBlock Text="ПРЕДПРОСМОТР" Foreground="White" FontSize="9"/></Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="18,18,18,16">
       <TextBlock Text="ВЫБРАННАЯ СЦЕНА" Foreground="{DynamicResource MutedBrush}" FontSize="9"/>
       <TextBlock x:Name="HeroTitle" FontSize="23" FontWeight="SemiBold" Margin="0,9,0,9" TextWrapping="Wrap"/>
       <TextBlock x:Name="HeroDescription" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
       <WrapPanel Margin="0,18,0,12"><Button x:Name="PreviewButton" Content="▷ Превью" Click="PreviewClick" FontSize="11" Padding="12,8" Margin="0,0,7,7"/><Button x:Name="FavoriteButton" Content="♡" Click="FavoriteClick" Padding="12,8" Margin="0,0,7,7" ToolTip="Избранное"/><Button x:Name="PlaylistButton" Content="＋ Плейлист" Click="PlaylistClick" FontSize="11" Padding="12,8" Margin="0,0,0,7"/></WrapPanel>
       <Button x:Name="CustomizeButton" Content="Настроить живую сцену" Click="CustomizeSceneClick" Padding="12,11" Background="{DynamicResource PrimaryBrush}" Foreground="White" Margin="0,0,0,8"/>
       <Button x:Name="VideoEditorButton" Content="Редактор видео" Click="EditorClick" Padding="12,9" Margin="0,0,0,8"/>
       <Button x:Name="RestoreOriginalButton" Content="Вернуть оригинал" Click="ResetSceneClick" Padding="12,7" Background="Transparent" FontSize="11"/>
      </StackPanel></ScrollViewer>
     </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,0,0,14">
     <Grid.RowDefinitions>
      <RowDefinition Height="108" />
      <RowDefinition />
     </Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="38"/><RowDefinition Height="30"/></Grid.RowDefinitions>
      <DockPanel><Button Content="⋯" DockPanel.Dock="Right" ToolTip="Наборы сцен" Click="CollectionMenuClick" FontSize="17" Padding="9,2"><Button.ContextMenu><ContextMenu><MenuItem Header="Экспортировать набор" Click="ExportBundleClick"/><MenuItem Header="Импортировать набор" Click="ImportBundleClick"/></ContextMenu></Button.ContextMenu></Button><TextBlock Text="Установленные" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <WrapPanel Grid.Row="1"><ComboBox x:Name="FormatPicker" Width="105" Height="30" FontSize="10" Margin="0,0,6,0" SelectionChanged="FormatChanged" SelectedIndex="0"><ComboBoxItem Content="Все форматы"/><ComboBoxItem Content="Видео"/><ComboBoxItem Content="Живые сцены"/></ComboBox>
       <ComboBox x:Name="MoodPicker" Width="120" Height="30" FontSize="10" Margin="0,0,6,0" SelectionChanged="MoodChanged"><ComboBoxItem Content="Все настроения"/><ComboBoxItem Content="Осень"/><ComboBoxItem Content="Зима"/><ComboBoxItem Content="Ночной Токио"/><ComboBoxItem Content="Спокойствие"/><ComboBoxItem Content="Космос"/><ComboBoxItem Content="Работа"/></ComboBox>
       <ComboBox x:Name="LibrarySort" Width="126" Height="30" FontSize="10" SelectionChanged="LibrarySortChanged"><ComboBoxItem Content="По названию"/><ComboBoxItem Content="Недавние"/><ComboBoxItem Content="Избранные сверху"/><ComboBoxItem Content="По коллекциям"/></ComboBox>
      </WrapPanel>
      <DockPanel Grid.Row="2"><Button x:Name="BundleApplyButton" Content="Применить набор" Click="ApplyBundleClick" DockPanel.Dock="Right" Padding="8,4" FontSize="10" Visibility="Collapsed"/><TextBlock x:Name="CountLabel" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/></DockPanel>
     </Grid>
     <ListBox x:Name="Library" Grid.Row="1" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="0">
      <ListBox.ItemsPanel>
       <ItemsPanelTemplate>
        <WrapPanel ItemWidth="{Binding ViewportWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer},Converter={StaticResource CardWidth},ConverterParameter=wallpaper}" />
       </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
         <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
           <Border x:Name="Card" CornerRadius="15" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}" Padding="5">
            <ContentPresenter />
           </Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
             <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
             <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
             <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value>
        </Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <StackPanel>
         <Grid Height="{Binding ActualWidth,RelativeSource={RelativeSource Self},Converter={StaticResource CardImageHeight}}" Background="#182130" SizeChanged="RoundCard" MouseEnter="CardEnter" MouseLeave="CardLeave">
          <Image Source="{Binding Thumbnail,Converter={StaticResource ThumbnailImage}}" Stretch="UniformToFill" />
         </Grid>
         <TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" Margin="10,11,10,5" TextTrimming="CharacterEllipsis" />
         <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="10,0,10,12" />
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource CardBrush}" CornerRadius="16" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="14,10">
     <Grid>
      <Grid.RowDefinitions>
       <RowDefinition />
       <RowDefinition Height="21" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="185" />
       <ColumnDefinition Width="80" />
       <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
       <TextBlock Text="ДИСПЛЕЙ" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,5" />
       <ComboBox x:Name="Monitor" SelectionChanged="MonitorChanged" FontSize="10" />
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
       <TextBlock Text="ЗВУК" FontSize="8" Foreground="{DynamicResource MutedBrush}" />
       <Slider x:Name="Volume" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
       <Button Content="←" FontSize="11" Width="28" Click="PreviousClick" ToolTip="Предыдущая сцена" Padding="9,10" Background="Transparent" />
       <Button Content="→" FontSize="11" Width="28" Click="NextClick" ToolTip="Следующая сцена" Padding="9,10" Background="Transparent" />
       <Button x:Name="PauseButton" Click="PauseClick" ToolTip="Пауза / продолжить" Padding="9,10" Background="Transparent" FontSize="11">
        <StackPanel Orientation="Horizontal">
         <Path x:Name="PauseGlyph" Data="M 3 1 L 3 13 M 9 1 L 9 13" Width="10" Height="12" Stroke="{DynamicResource InkBrush}" StrokeThickness="2.2" Margin="0,0,7,0" />
         <TextBlock x:Name="PauseLabel" Text="Пауза" FontSize="11" />
        </StackPanel>
       </Button>
       <Button Click="StopClick" ToolTip="Остановить обои" Padding="9,10" Background="Transparent" Margin="0,0,8,0" FontSize="11">
        <StackPanel Orientation="Horizontal">
         <Rectangle Width="9" Height="9" RadiusX="1" RadiusY="1" Fill="{DynamicResource InkBrush}" Margin="0,0,7,0" />
         <TextBlock Text="Стоп" FontSize="11" />
        </StackPanel>
       </Button>
       <Button Content="Применить  ↗" Click="ApplyClick" Background="{DynamicResource PrimaryBrush}" Foreground="White" Padding="16,11" FontSize="11" />
      </StackPanel>
      <TextBlock x:Name="Status" Grid.Row="1" Grid.ColumnSpan="3" Text="Готово к движению" Foreground="{DynamicResource MutedBrush}" FontSize="9" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" />
     </Grid>
    </Border>
   </Grid>
   <local:AppearancePanel x:Name="Appearance" Grid.Column="1" Visibility="Collapsed" />
   <local:CityPanel x:Name="City" Grid.Column="1" Visibility="Collapsed" />
  </Grid>
  <Border x:Name="SettingsOverlay" Grid.RowSpan="2" Background="#700E1020" Visibility="Collapsed">
   <local:SettingsPanel x:Name="Settings" Width="650" Margin="30" VerticalAlignment="Center" />
  </Border>
  <Border x:Name="EditorOverlay" Grid.RowSpan="2" Background="#900E1020" Visibility="Collapsed">
   <local:VideoEditor x:Name="Editor" Width="660" Margin="30" VerticalAlignment="Center" />
  </Border>
  <Border x:Name="GalleryOverlay" Grid.RowSpan="2" Background="#900E1020" Visibility="Collapsed">
   <local:GalleryPanel x:Name="Gallery" Width="730" Margin="30" VerticalAlignment="Center" />
  </Border>
  <Border x:Name="PublishOverlay" Grid.RowSpan="2" Background="#A00E1020" Visibility="Collapsed">
   <local:PublishPanel x:Name="Publish" Width="590" Margin="30" VerticalAlignment="Center" />
  </Border>
  <Popup x:Name="QualityPopup" PlacementTarget="{Binding ElementName=QualityButton}" Placement="Bottom" HorizontalOffset="-180" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None">
   <Border Width="365" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
    <StackPanel>
     <TextBlock Text="Качество и нагрузка" FontSize="17" FontWeight="SemiBold" />
     <TextBlock Text="Режим применяется ко всем экранам." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,15" />
     <Button x:Name="QualityEco" Tag="Eco" Click="QualityPresetClick" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,7">
      <StackPanel>
       <TextBlock Text="Экономия" FontWeight="SemiBold" />
       <TextBlock Text="720p · видео до 15, живые сцены до 30 FPS" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
       <TextBlock Text="Без теней и отражений, упрощённый 3D." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
      </StackPanel>
     </Button>
     <Button x:Name="QualityAuto" Tag="Auto" Click="QualityPresetClick" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,7">
      <StackPanel>
       <TextBlock Text="Автоматически" FontWeight="SemiBold" />
       <TextBlock Text="Видео до 30 FPS. Город подстраивается под GPU." FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
      </StackPanel>
     </Button>
     <Button x:Name="QualityBalance" Tag="Balance" Click="QualityPresetClick" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,7">
      <StackPanel>
       <TextBlock Text="Баланс" FontWeight="SemiBold" />
