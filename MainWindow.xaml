<Window x:Class="VWP.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VWP" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="VWP" Icon="assets/app.ico" Width="1160" Height="760" MinWidth="980" MinHeight="640" WindowStyle="None" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="Manual" KeyDown="WindowKeyDown" AllowDrop="True" Drop="FilesDropped" DragOver="FilesDragOver">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Grid Background="{DynamicResource CanvasBrush}"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
  <Grid Background="{DynamicResource CanvasBrush}"><Border Background="{DynamicResource PanelBrush}" Width="184" HorizontalAlignment="Left"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource TrafficLight}" Background="#FF6058" ToolTip="Закрыть VWP" Click="QuitClick"><TextBlock Text="×"/></Button>
    <Button Style="{StaticResource TrafficLight}" Background="#FFBD2E" ToolTip="Свернуть в трей" Click="TrayClick" Margin="8,0,0,0"><TextBlock Text="−"/></Button>
    <Button Style="{StaticResource TrafficLight}" Background="#28C840" ToolTip="Полноэкранный / компактный режим" Click="ModeClick" Margin="8,0,0,0"><TextBlock Text="↗"/></Button>
   </StackPanel>
   <TextBlock x:Name="ModeLabel" Text="VWP · Компактный режим" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
  </Grid>
 <Grid Grid.Row="1">
  <Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="20,27,20,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><StackPanel Orientation="Horizontal" Margin="8,0,0,0"><Image Source="assets/app.png" Width="32" Height="32"/><TextBlock Text="VWP" FontSize="19" FontWeight="SemiBold" Margin="10,2,0,0"/></StackPanel><TextBlock Text="VIDEO WALLPAPER" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="9,13,0,22"/>
     <StackPanel x:Name="SidebarCategories"><Button Content="♡  Избранное" Tag="Избранное" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,7"/><Button Content="♫  Плейлист" Tag="Плейлист" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,7"/><Button Content="Все сцены" Tag="Все сцены" Click="CategoryClick" Background="{DynamicResource CardBrush}" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Аниме" Tag="Аниме" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Город" Tag="Город" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Природа" Tag="Природа" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Космос" Tag="Космос" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Фэнтези" Tag="Фэнтези" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Абстракция" Tag="Абстракция" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/><Button Content="Импорт" Tag="Импорт" Click="CategoryClick" Background="Transparent" HorizontalContentAlignment="Left" FontSize="12" Padding="12,6" Margin="0,0,0,1"/></StackPanel><Button Content="＋  Импорт видео" Click="ImportClick" Background="Transparent" FontSize="12" Padding="8,13" HorizontalAlignment="Left" Margin="5,5,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="8,0"><Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,16"/><Button Content="Галерея  ↗" Click="GalleryClick" Background="Transparent" HorizontalContentAlignment="Left" Padding="0,7"/><Button Content="Настройки  ⚙" Click="SettingsClick" Background="Transparent" HorizontalContentAlignment="Left" Padding="0,9" Margin="0,0,0,8"/><CheckBox x:Name="Autostart" Content="Автозапуск" Click="AutostartClick"/><TextBlock Text="Создай своё настроение." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource MutedBrush}" LineHeight="20" Margin="0,22,0,10"/><TextBlock Text="VWP  /  WINDOWS EDITION" FontSize="8" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,23,28,18"><Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="205"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
   <Grid><StackPanel><TextBlock Text="Твоё пространство" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Немного движения. Совсем другое настроение." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,0,0"><Border Width="160" Background="{DynamicResource ControlBrush}" CornerRadius="10" Margin="0,0,10,0" Padding="12,10"><Grid><TextBox x:Name="SearchBox" Padding="0" TextChanged="SearchChanged" Background="Transparent" BorderThickness="0" FontSize="12" VerticalContentAlignment="Center"/><TextBlock Text="Поиск сцен" Foreground="{DynamicResource MutedBrush}" FontSize="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border><Button Content="＋  Добавить" Click="ImportClick" Background="{DynamicResource CardBrush}"/></StackPanel></Grid>
   <Border x:Name="Hero" Grid.Row="1" CornerRadius="18" Background="#141329" SizeChanged="RoundHero" Margin="0,0,0,20">
    <Grid><Image x:Name="HeroImage" Stretch="UniformToFill"/><MediaElement x:Name="HeroVideo" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Close" Volume="0" Stretch="UniformToFill"/><Border><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#DC111322" Offset="0"/><GradientStop Color="#80111322" Offset="0.43"/><GradientStop Color="#00111322" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#35FFFFFF" CornerRadius="12" Margin="0,18,18,0" Padding="12,6"><TextBlock Text="VWP ORIGINAL" Foreground="#F2F0FA" FontSize="9" FontWeight="Medium"/></Border>
     <StackPanel VerticalAlignment="Bottom" Margin="27,0,0,26"><TextBlock Text="SCENES FOR YOUR SPACE" Foreground="#C2BBD8" FontSize="9"/><TextBlock x:Name="HeroTitle" Text="Sakura Midnight" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,9,0,8"/><TextBlock x:Name="HeroDescription" Text="Тихий город. Свет. Бесконечный цикл." Foreground="#C5C3D3" FontSize="12"/><StackPanel Orientation="Horizontal"><Button x:Name="PreviewButton" Content="▷  Смотреть превью" Click="PreviewClick" Background="#30FFFFFF" Foreground="White" FontSize="11" Padding="12,8" HorizontalAlignment="Left" Margin="0,12,0,0"/><Button x:Name="FavoriteButton" Content="♡" Click="FavoriteClick" Background="#30FFFFFF" Foreground="White" Padding="12,8" Margin="8,12,0,0"/><Button x:Name="PlaylistButton" Content="＋ Плейлист" Click="PlaylistClick" Background="#30FFFFFF" Foreground="White" FontSize="11" Padding="12,8" Margin="8,12,0,0"/><Button Content="Редактор" Click="EditorClick" Background="#30FFFFFF" Foreground="White" FontSize="11" Padding="12,8" Margin="8,12,0,0"/></StackPanel></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions><DockPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Коллекция" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/><ComboBox x:Name="MoodPicker" Width="153" Height="38" Margin="14,0,0,6" SelectionChanged="MoodChanged" ToolTip="Подборки настроений"><ComboBoxItem Content="Все настроения"/><ComboBoxItem Content="Ночной Токио"/><ComboBoxItem Content="Спокойствие"/><ComboBoxItem Content="Космос"/><ComboBoxItem Content="Работа"/></ComboBox></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="↗ Экспорт" Click="ExportBundleClick" Padding="8,6" FontSize="10" Background="Transparent"/><Button Content="↙ Набор" Click="ImportBundleClick" Padding="8,6" FontSize="10" Background="Transparent"/><Button x:Name="BundleApplyButton" Content="Применить набор" Click="ApplyBundleClick" Padding="8,6" FontSize="10" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></DockPanel>
    <ListBox x:Name="Library" Grid.Row="1" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" Padding="0">
     <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="{Binding ViewportWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer},Converter={StaticResource CardWidth}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,12,5"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="13" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}" Padding="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel><Grid Height="96" Background="#272638" SizeChanged="RoundCard" MouseEnter="CardEnter" MouseLeave="CardLeave"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid><TextBlock Text="{Binding Name}" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" Margin="8,9,8,4"/><TextBlock Text="{Binding Subtitle}" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="8,0,8,7"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <Border Grid.Row="3" Background="{DynamicResource CardBrush}" CornerRadius="14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16,12"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="21"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0"><TextBlock Text="ДИСПЛЕЙ" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,5"/><ComboBox x:Name="Monitor" SelectionChanged="MonitorChanged"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="ЗВУК" FontSize="8" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Volume" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="←" FontSize="16" Width="28" Click="PreviousClick" ToolTip="Предыдущая сцена плейлиста" Padding="7,11" Background="Transparent"/><Button Content="→" FontSize="16" Width="28" Click="NextClick" ToolTip="Следующая сцена плейлиста" Padding="7,11" Background="Transparent"/><Button x:Name="PauseButton" Content="Ⅱ  Пауза" Click="PauseClick" ToolTip="Пауза / продолжить" Width="85" Padding="8,11" Background="Transparent"/><Button Content="■  Стоп" Click="StopClick" ToolTip="Остановить обои" Width="70" Padding="8,11" Background="Transparent" Margin="0,0,12,0"/><Button Content="Применить обои  ↗" Click="ApplyClick" Background="{DynamicResource PrimaryBrush}" Foreground="White" Padding="14,11"/></StackPanel>
    <TextBlock x:Name="Status" Grid.Row="1" Grid.ColumnSpan="3" Text="Готово к движению" Foreground="{DynamicResource MutedBrush}" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
   </Grid></Border>
  </Grid>
 </Grid>
  <Border x:Name="SettingsOverlay" Grid.RowSpan="2" Background="#700E1020" Visibility="Collapsed"><local:SettingsPanel x:Name="Settings" Width="650" Margin="30" VerticalAlignment="Center"/></Border>
  <Border x:Name="EditorOverlay" Grid.RowSpan="2" Background="#900E1020" Visibility="Collapsed"><local:VideoEditor x:Name="Editor" Width="660" Margin="30" VerticalAlignment="Center"/></Border>
  <Border x:Name="GalleryOverlay" Grid.RowSpan="2" Background="#900E1020" Visibility="Collapsed"><local:GalleryPanel x:Name="Gallery" Width="730" Margin="30" VerticalAlignment="Center"/></Border>
  <Border x:Name="PublishOverlay" Grid.RowSpan="2" Background="#A00E1020" Visibility="Collapsed"><local:PublishPanel x:Name="Publish" Width="590" Margin="30" VerticalAlignment="Center"/></Border>
 </Grid>
</Window>
