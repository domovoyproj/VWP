<UserControl x:Class="VWP.SettingsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource CanvasBrush}" CornerRadius="22" Padding="26">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><Button x:Name="CloseButton" Content="×" DockPanel.Dock="Right" Background="Transparent" Padding="12,3"/><StackPanel><TextBlock Text="Всё под твоим контролем" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="DisplayLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></DockPanel>
   <ScrollViewer Grid.Row="1" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,0">
     <TextBlock Text="Кадрирование дисплея" FontSize="15" FontWeight="SemiBold"/>
     <Grid Margin="0,12,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#171722" CornerRadius="12" ClipToBounds="True" Height="140"><Canvas x:Name="CropCanvas" ClipToBounds="True"><Image x:Name="CropImage" Stretch="Fill"/></Canvas></Border>
      <StackPanel Grid.Column="1" Margin="18,0,0,0"><ComboBox x:Name="FitMode" SelectionChanged="CropChanged"><ComboBoxItem Content="Заполнить экран"/><ComboBoxItem Content="Вписать целиком"/></ComboBox><TextBlock Text="Фокус по горизонтали" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/><Slider x:Name="FocusX" Minimum="0" Maximum="1" Value="0.5" ValueChanged="FocusChanged"/><TextBlock Text="Фокус по вертикали" FontSize="10" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="FocusY" Minimum="0" Maximum="1" Value="0.5" ValueChanged="FocusChanged"/></StackPanel>
     </Grid>
     <TextBlock Text="Плейлист этого дисплея" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,12"/>
     <TextBox x:Name="PlaylistName" Padding="10,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"/>
     <StackPanel Orientation="Horizontal" Margin="0,13,0,13"><CheckBox x:Name="PlaylistEnabled" Content="Менять сцены"/><CheckBox x:Name="Shuffle" Content="Случайный порядок" Margin="24,0,0,0"/></StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Интервал, минут" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="Interval" Padding="10,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="С (ЧЧ:ММ)" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ScheduleStart" Padding="10,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="До (ЧЧ:ММ)" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="ScheduleEnd" Padding="10,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"/></StackPanel></Grid>
     <TextBlock Text="Одинаковое время — весь день. Сцены добавляются кнопкой «＋ Плейлист»." FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,6"/>
     <ListBox x:Name="PlaylistEntries" MaxHeight="100" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" DisplayMemberPath="Name"/>
     <StackPanel Orientation="Horizontal" Margin="0,5,0,15"><Button x:Name="MoveUp" Content="↑" Padding="12,6"/><Button x:Name="MoveDown" Content="↓" Padding="12,6" Margin="6,0"/><Button x:Name="RemoveEntry" Content="Убрать" Padding="12,6"/><TextBlock x:Name="PlaylistCount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
     <TextBlock Text="Живая глубина и музыка" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <CheckBox x:Name="Interactive" Content="Интерактивный фон вместо видео" Margin="0,0,0,12"/>
     <CheckBox x:Name="Music" Content="Реакция света и частиц на системный звук" Margin="0,0,0,12"/>
     <TextBlock Text="Глубина параллакса" Foreground="{DynamicResource MutedBrush}"/><Slider x:Name="Depth" Minimum="0" Maximum="1" Value="0.65"/>
     <TextBlock x:Name="LayersLabel" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,8"/>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><Button x:Name="BackgroundButton" Content="Выбрать фон" Padding="12,8"/><Button x:Name="ForegroundButton" Content="PNG персонажа" Padding="12,8" Margin="8,0,0,0"/></StackPanel>
     <TextBlock Text="Профиль производительности" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ComboBox x:Name="Performance"><ComboBoxItem Content="Экономия · 15 FPS / 720p"/><ComboBoxItem Content="Баланс · 30 FPS / 1080p"/><ComboBoxItem Content="Качество · 60 FPS / исходное видео"/></ComboBox>
     <TextBlock x:Name="ResourcesLabel" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,8,0,16" TextWrapping="Wrap"/>
     <TextBlock Text="Исключения автопаузы: имена EXE через запятую" FontSize="11"/><TextBox x:Name="Exceptions" Padding="10,8" Margin="0,6,0,16"/>
     <TextBlock Text="Внешний вид" FontWeight="SemiBold" Margin="0,0,0,8"/><ComboBox x:Name="Theme"><ComboBoxItem Content="Светлая тема"/><ComboBoxItem Content="Тёмная тема"/><ComboBoxItem Content="Как в Windows"/></ComboBox>
     <CheckBox x:Name="SceneAccent" Content="Акцентный цвет выбранной сцены" Margin="0,12,0,16"/>
     <TextBlock Text="Источник онлайн-галереи · HTTPS-каталог" FontSize="11"/><TextBox x:Name="GallerySource" Padding="10,8" Margin="0,6,0,18"/>
     <TextBlock Text="Производительность и лаунчер" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <CheckBox x:Name="PauseFullscreen" Content="Пауза при полноэкранном приложении на дисплее" Margin="0,0,0,12"/>
     <CheckBox x:Name="PauseBattery" Content="Пауза при работе от батареи" Margin="0,0,0,12"/>
     <CheckBox x:Name="HoverPreview" Content="Тихое превью при наведении на карточку" Margin="0,0,0,12"/>
     <CheckBox x:Name="CheckUpdates" Content="Проверять обновления при запуске" Margin="0,0,0,16"/>
     <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14"><StackPanel><TextBlock x:Name="VersionLabel" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatus" Text="Обновления из GitHub VWP" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="Проверить" Padding="13,8"/><Button x:Name="InstallUpdateButton" Content="Скачать и установить" Padding="13,8" Margin="8,0,0,0" Visibility="Collapsed"/></StackPanel></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Error" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><Button x:Name="SaveButton" Content="Сохранить настройки" Background="{DynamicResource PrimaryBrush}" Foreground="White" HorizontalAlignment="Right"/></StackPanel>
  </Grid>
 </Border>
</UserControl>
